#================================= api =================================
# EXPO_PUBLIC_API_BASE=https://api.happyjack.cloud
EXPO_PUBLIC_API_BASE=

#================================= google =================================
GOOGLE_SERVICES_PLIST=
GOOGLE_SERVICES_JSON=
# Android 지도 미리보기 (Maps SDK for Android). GCP에서 발급 후 Maps SDK for Android 활성화
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google 로그인 (GCP OAuth 2.0 Web client ID — 필수)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID (선택, 미설정 시 GoogleService-Info.plist 사용)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS URL scheme = REVERSED_CLIENT_ID (GoogleService-Info.plist)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
